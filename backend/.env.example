# Environment variables template
# Copy this to backend/.env and fill in your values

# Application
ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database (default: local Docker PostgreSQL)
# For local development, keep as is (port 5436 to avoid conflicts):
DATABASE_URL=postgresql+asyncpg://docintel:docintel_secret_password@localhost:5436/docintel_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# AI/ML API Keys
# Add your API keys for LLM services
OPENAI_API_KEY=sk_your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here

# Model Artifacts (paths to downloaded/trained models)
MODEL_ARTIFACT_PATH=ml/artifacts/classification
FAISS_INDEX_PATH=ml/artifacts/retrieval/corpus_faiss.index
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Logging
LOG_LEVEL=INFO

# Frontend (if using backend as API server)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
